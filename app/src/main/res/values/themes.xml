<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HeltecADSB" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rev_blue</item>
        <item name="colorPrimaryVariant">@color/rev_blue_pressed</item>
        <item name="colorOnPrimary">@color/rev_text_on_blue</item>
        <item name="colorSecondary">@color/rev_green</item>
        <item name="android:colorBackground">@color/rev_bg</item>
        <item name="android:statusBarColor">@color/rev_bg</item>
        <item name="android:navigationBarColor">@color/rev_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="RevolutCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/rev_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="RevolutPillButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="RevolutSecondaryButton" parent="RevolutPillButton">
        <item name="backgroundTint">@color/rev_surface_secondary</item>
        <item name="android:textColor">@color/rev_text_primary</item>
    </style>

    <style name="RevolutPrimaryButton" parent="RevolutPillButton">
        <item name="backgroundTint">@color/rev_blue</item>
        <item name="android:textColor">@color/rev_text_on_blue</item>
    </style>
</resources>
